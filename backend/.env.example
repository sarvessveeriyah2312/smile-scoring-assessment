//DB connection string for backend
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/DB_NAME
PAYLOAD_KEY=
COOKIE_SECURE=false
REDIS_URL=redis://localhost:6379/0

# Google sign-in. Leave empty to turn it off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The frontend address Google redirects back to (local: http://localhost:3000)
PUBLIC_URL=http://localhost:3000
